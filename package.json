{
  "name": "dsh-serial-job-session",
  "version": "5.1.1",
  "description": "Contract-and-evidence workflow for long AI tasks: the serial-job-session v5 skill, an `sjs` tool that runs its local CLI, and a settings panel for interpreter, timeout and extra arguments.",
  "type": "module",
  "license": "MIT",
  "author": "沈劢 (shenmai@taiyouxi.cn)",
  "homepage": "https://github.com/FMJ9922/serial-job-session",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FMJ9922/serial-job-session.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "skill",
    "workflow",
    "serial-job-session"
  ],
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./locale/*.json": "./dsh/locale/*.json",
    "./icon": "./dsh/icon.svg"
  },
  "files": [
    "dsh/index.js",
    "dsh/client.js",
    "dsh/cordis.patch.yml",
    "dsh/locale/*.json",
    "dsh/icon.svg",
    "dsh/INTRO.md",
    "dsh/INTRO.en.md",
    "dsh/plugin.test.mjs",
    "scripts/**/*.py",
    "references/*.md",
    "schemas/*.json",
    "examples/*.json",
    "SKILL.md",
    "INSTALL.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CREDITS.md",
    "LICENSE",
    "VERSION",
    "defaults.json",
    "roles.json"
  ],
  "scripts": {
    "test:plugin": "node --test dsh/plugin.test.mjs",
    "check:plugin": "node --check dsh/index.js && node --check dsh/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}

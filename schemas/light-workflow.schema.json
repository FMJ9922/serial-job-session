{
  "$id": "serial-job-session-light-workflow/v1",
  "type": "object",
  "required": ["schema", "parent_job_id", "revision", "nodes"],
  "properties": {
    "schema": {"const": "serial-job-session-light-workflow/v1"},
    "parent_job_id": {"type": "string"},
    "revision": {"type": "integer"},
    "max_depth": {"type": "integer", "minimum": 1, "maximum": 1},
    "max_nodes": {"type": "integer", "minimum": 1, "maximum": 4},
    "execution_root": {"type": "string"},
    "nodes": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "role", "writes"],
        "properties": {
          "id": {"type": "string"},
          "role": {"enum": ["research", "execute", "review"]},
          "writes": {"type": "array", "items": {"type": "string"}},
          "readonly": {"type": "boolean"},
          "required": {"type": "boolean"},
          "status": {"enum": ["pending", "running", "completed", "failed", "cancelled"]},
          "close_requested": {"type": "boolean"},
          "nested_agents": {"type": "array", "maxItems": 0},
          "independent_schedule": {"type": "boolean"},
          "independent_accept": {"type": "boolean"},
          "independent_reject": {"type": "boolean"},
          "independent_depends": {"type": "boolean"},
          "human_decision": {"type": "boolean"},
          "resources": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}

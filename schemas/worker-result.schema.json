{
  "$id": "serial-job-session-worker-result/v1",
  "type": "object",
  "required": ["schema", "job_id", "status", "close_requested", "control_writes", "writes"],
  "properties": {
    "schema": {"const": "serial-job-session-worker-result/v1"},
    "job_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "done_pending",
        "failed",
        "cancelled",
        "split_required",
        "probe_failed",
        "human_only",
        "dependency_ambiguous",
        "worker_lost"
      ]
    },
    "stop": {"type": ["string", "null"]},
    "reviewer": {"enum": ["pass", "blocking", "skipped", "pending"]},
    "close_requested": {"type": "boolean"},
    "control_writes": {"type": "array", "items": {"type": "string"}},
    "writes": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
